# Vorlage für die Datei ".env". Kopieren mit:  cp .env.example .env
# Die echte .env enthält Geheimnisse und darf NIE ins Git.

# --- Allgemein ---
NODE_ENV=development
PORT=3000
# Öffentliche Adresse der Anwendung (für Links in E-Mails und SMS)
BASE_URL=http://localhost:3000

# --- Datenbank ---
# Es gibt zwei Zugänge mit je eigenem Passwort:
# Besitzer (pflege_owner): nur für Migrationen und Verwaltungs-Skripte.
DB_OWNER_PASSWORD=dev_owner_passwort
# Anwendung (pflege_app): eingeschränkt. Für diesen Zugang erzwingt die
# Datenbank die Trennung der Pflegedienste (Row Level Security).
DB_APP_PASSWORD=dev_app_passwort
# Wo die Datenbank läuft. In Docker Compose wird DB_HOST automatisch gesetzt.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pflege

# --- Verschlüsselung der sensiblen Felder ---
# Format: "<Nummer>:<Schlüssel>", mehrere durch Komma getrennt.
# Neuen Schlüssel erzeugen mit:  openssl rand -base64 32
# WICHTIG: Schlüssel getrennt von den Datensicherungen aufbewahren!
# (Dieser Beispielschlüssel ist öffentlich bekannt - nur für lokale Tests.)
DATA_KEYS=1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Nummer des Schlüssels, mit dem neu verschlüsselt wird
DATA_KEY_ACTIVE=1

# --- Betreiber ---
# An diese Adresse gehen Warn-E-Mails (ohne Inhalte).
OPERATOR_EMAIL=betreiber@example.org

# --- Anmeldung ---
# "true" macht die Zwei-Faktor-Anmeldung für alle zur Pflicht.
# Vor dem Start mit echten Daten einschalten!
REQUIRE_2FA=false
